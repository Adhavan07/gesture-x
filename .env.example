# PORT: Port the Express + Vite server listens on (default 3000)
PORT=3000

# UPLOAD_DIR: Local directory path for uploaded file storage
UPLOAD_DIR="./uploads"

# MAX_UPLOAD_SIZE_MB: Maximum allowed size per uploaded file in megabytes
MAX_UPLOAD_SIZE_MB=50

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
